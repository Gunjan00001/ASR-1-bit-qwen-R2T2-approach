#!/bin/bash
#PBS -N asr1bit-stream-aligned2bin2
#PBS -q gpu
#PBS -l select=1:ncpus=4:ngpus=1:mem=48gb
#PBS -l walltime=06:00:00
#PBS -j oe
#PBS -o /home/jiit_992401210050/stream_aligned2bin2.out
#
# WP1/T4.3 — aligned-target streaming SFT (the plan's core Stage-4 recipe).
#
# Targets come from the *forced aligner*, not from the model or the teacher:
# at each 320 ms chunk the sample's target is exactly the words whose end time
# falls inside that chunk (T4.2), i.e. "emit what you have heard, then stop".
# That is the supervision the earlier streaming recipes lacked, and it addresses
# both measured failure directions at once (under-emission and repetition
# loops). Empty-target chunks are the stop samples; `--aligned-stop-stride 2`
# keeps every second one so the mix is not dominated by silence teaching.
# Progressive precision: binary from the best ternary streaming checkpoint
# (bit_width 1.0; never train binary from fp). # Init old: (offline 7.52 — the best offline base);
# 2 400 aligned utterances (base quality was the limit of the 12.61 run).
# Guardrail: 20-utt official-algorithm `STREAM` evals every 250 steps.
# Submit: qsub scripts/qat_stream_aligned.pbs

set -u
unset CUDA_VISIBLE_DEVICES

ROOT="/home/jiit_992401210050/Desktop/ASR 1bit qwen"
cd "$ROOT" || exit 1

export PYTHONPATH="$ROOT/src"
export TOKENIZERS_PARALLELISM=false
export HF_HOME=/tmp/asr1bit/hf
LOG="artifacts/stage1/qat_stream_aligned2bin2.log"

PY=/home/jiit_992401210050/miniconda3/bin/python  # bitsandbytes lives in the shared env
if [ -d /tmp/asr1bit/models/Qwen3-ASR-0.6B ]; then
  MODEL=/tmp/asr1bit/models/Qwen3-ASR-0.6B
else
  MODEL=Qwen/Qwen3-ASR-0.6B
fi
if [ -f /tmp/asr1bit/qat_clean_train.100_n8000.pt ]; then
  CACHE=/tmp/asr1bit/qat_clean_train.100_n8000.pt
else
  CACHE="$ROOT/data/qat_clean_train.100_n8000.pt"
fi

PICK=$(for _ in 1 2 3; do
  nvidia-smi --query-gpu=index,memory.used,utilization.gpu --format=csv,noheader,nounits
  sleep 1
done | awk -F', ' '$2 < 25000 {u[$1]+=$3; m[$1]=$2} END {for (g in u) print u[g], m[g], g}' \
  | sort -n | head -1 | awk '{print $3}')
[ -z "$PICK" ] && PICK=$(nvidia-smi --query-gpu=index,memory.used --format=csv,noheader,nounits \
  | sort -t, -k2 -n | head -1 | cut -d, -f1 | tr -d ' ')
PICK="${QAT_GPU:-$PICK}"
export CUDA_VISIBLE_DEVICES="$PICK"

{
  echo "=== host $(hostname) | GPU $CUDA_VISIBLE_DEVICES | $(date) ==="
  nvidia-smi --query-gpu=index,name,memory.used,utilization.gpu --format=csv,noheader
} | tee "$LOG"

"$PY" scripts/run_stage1_qat.py \
  --model "$MODEL" \
  --policy decoder_attn_ffn \
  --bit-width 1.0 \
  --learnable-scale 1 \
  --init-from data/checkpoints/qat_stream_aligned2/step2500.pt \
  --aligned-targets 1 \
  --aligned-n 2400 \
  --aligned-lookahead-ms 0 \
  --aligned-stop-stride 2 \
  --op-max-samples 2400 \
  --op-mix-frac 0.5 \
  --op-chunk-ms 320 \
  --steps 1500 \
  --train-cache "$CACHE" \
  --train-n 2400 \
  --eval-n 50 \
  --eval-every 500 \
  --eval-both 0 \
  --eval-fp16 1 \
  --stream-eval-every 250 \
  --stream-eval-n 20 \
  --lr 3e-6 \
  --warmup-steps 100 \
  --lr-schedule cosine \
  --batch-size 2 \
  --max-new-tokens 128 \
  --alpha-mode delay \
  --alpha-warmup-frac 0.02 \
  --distill-weight 0.05 \
  --distill-temp 2.0 \
  --frozen-teacher 1 \
  --lazy-collate 1 \
  --save-dir data/checkpoints/qat_stream_aligned2_bin2 \
  --save-every 250 \
  --out artifacts/stage1 \
  2>&1 | tee -a "$LOG"
