#!/bin/bash
#PBS -N asr1bit-state-smoke
#PBS -q gpu
#PBS -l select=1:ncpus=4:ngpus=1:mem=48gb
#PBS -l walltime=00:40:00
#PBS -j oe
#PBS -o /home/jiit_992401210050/state_distill_smoke2.out
#
# Phase-3 smoke test: 5 real training steps with the streaming-state loss on
# the 0.6B (fast load, real Qwen3-ASR modules). Verifies the hook path, the
# frozen teacher, the aligned streaming batches, and finite gradients before
# spending 1.7B GPU-hours.
#
# Submit: qsub scripts/state_distill_smoke2.pbs

set -u
unset CUDA_VISIBLE_DEVICES

ROOT="/home/jiit_992401210050/Desktop/ASR 1bit qwen"
cd "$ROOT" || exit 1

export PYTHONPATH="$ROOT/src"
export TOKENIZERS_PARALLELISM=false
export HF_HOME=/tmp/asr1bit/hf
LOG="artifacts/stage1/state_distill_smoke2.log"
PY=/home/jiit_992401210050/miniconda3/bin/python
if [ -x /tmp/asr1bit/miniconda3/bin/python ]; then PY=/tmp/asr1bit/miniconda3/bin/python; fi
if [ -d /tmp/asr1bit/models/Qwen3-ASR-0.6B ]; then
  MODEL=/tmp/asr1bit/models/Qwen3-ASR-0.6B
else
  MODEL=Qwen/Qwen3-ASR-0.6B
fi
if [ -f /tmp/asr1bit/qat_clean_train.100_n8000.pt ]; then
  CACHE=/tmp/asr1bit/qat_clean_train.100_n8000.pt
else
  CACHE="$ROOT/data/qat_clean_train.100_n8000.pt"
fi

PICK=$(bash scripts/pick_gpu_wait.sh 20000 "${PICK_WAIT_MIN:-60}") || exit 0
PICK="${QAT_GPU:-$PICK}"
export CUDA_VISIBLE_DEVICES="$PICK"

{
  echo "=== host $(hostname) | GPU $CUDA_VISIBLE_DEVICES | $(date) ==="
  nvidia-smi --query-gpu=index,name,memory.used,utilization.gpu --format=csv,noheader
} | tee "$LOG"

"$PY" scripts/run_stage1_qat.py \
  --model "$MODEL" \
  --policy decoder_attn_ffn \
  --bit-width 1.58 \
  --learnable-scale 1 \
  --init-from data/checkpoints/qat_ternary_full/last.pt \
  --aligned-targets 1 \
  --aligned-n 16 \
  --aligned-stop-stride 2 \
  --op-max-samples 64 \
  --op-mix-frac 0.5 \
  --op-chunk-ms 320 \
  --steps 12 \
  --train-cache "$CACHE" \
  --train-n 64 \
  --eval-n 2 \
  --eval-every 0 \
  --stream-eval-every 0 \
  --lr 5e-7 \
  --warmup-steps 1 \
  --lr-schedule const \
  --batch-size 1 \
  --optimizer adamw \
  --max-new-tokens 128 \
  --alpha-mode delay \
  --alpha-warmup-frac 0.02 \
  --distill-weight 0.05 \
  --distill-temp 2.0 \
  --frozen-teacher 1 \
  --state-distill-weight 0.05 \
  --state-distill-layer -1 \
  --state-distill-normalize 1 \
  --lazy-collate 1 \
  --save-dir data/checkpoints/state_distill_smoke2 \
  --out artifacts/stage1 \
  2>&1 | tee -a "$LOG"
