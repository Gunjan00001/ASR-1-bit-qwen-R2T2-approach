#!/bin/bash
#PBS -N asr1bit-binary-full
#PBS -q gpu
#PBS -l select=1:ncpus=4:ngpus=1:mem=48gb
#PBS -l walltime=08:00:00
#PBS -j oe
#PBS -o /home/jiit_992401210050/binary_full.out
#
# WP2 — offline scale-up: binary continuation on the full 28 539-utterance
# train-clean-100 cache. Init: the *full-cache ternary* checkpoint (7.5 WER,
# progressive precision — never train binary from fp; see HANDOFF recipe).
# Fresh cosine cycle lr 1e-5, anchor 0.05.
# Submit: qsub scripts/qat_binary_full.pbs

set -u
unset CUDA_VISIBLE_DEVICES

ROOT="/home/jiit_992401210050/Desktop/ASR 1bit qwen"
cd "$ROOT" || exit 1

export PYTHONPATH="$ROOT/src"
export TOKENIZERS_PARALLELISM=false
export HF_HOME=/tmp/asr1bit/hf
LOG="artifacts/stage1/qat_binary_full.log"

if [ -x /tmp/asr1bit/miniconda3/bin/python ]; then
  PY=/tmp/asr1bit/miniconda3/bin/python
else
  PY=/home/jiit_992401210050/miniconda3/bin/python
fi
if [ -d /tmp/asr1bit/models/Qwen3-ASR-0.6B ]; then
  MODEL=/tmp/asr1bit/models/Qwen3-ASR-0.6B
else
  MODEL=Qwen/Qwen3-ASR-0.6B
fi
if [ -f /tmp/asr1bit/qat_clean_train.100_full.pt ]; then
  CACHE=/tmp/asr1bit/qat_clean_train.100_full.pt
else
  CACHE="$ROOT/data/qat_clean_train.100_full.pt"
fi

PICK=$(for _ in 1 2 3; do
  nvidia-smi --query-gpu=index,memory.used,utilization.gpu --format=csv,noheader,nounits
  sleep 1
done | awk -F', ' '$2 < 45000 {u[$1]+=$3; m[$1]=$2} END {for (g in u) print u[g], m[g], g}' \
  | sort -n | head -1 | awk '{print $3}')
[ -z "$PICK" ] && PICK=$(nvidia-smi --query-gpu=index,memory.used --format=csv,noheader,nounits \
  | sort -t, -k2 -n | head -1 | cut -d, -f1 | tr -d ' ')
PICK="${QAT_GPU:-$PICK}"
export CUDA_VISIBLE_DEVICES="$PICK"

{
  echo "=== host $(hostname) | GPU $CUDA_VISIBLE_DEVICES | cache $CACHE | $(date) ==="
  nvidia-smi --query-gpu=index,name,memory.used,utilization.gpu --format=csv,noheader
} | tee "$LOG"

"$PY" scripts/run_stage1_qat.py \
  --model "$MODEL" \
  --policy decoder_attn_ffn \
  --bit-width 1.0 \
  --learnable-scale 1 \
  --init-from data/checkpoints/qat_ternary_full/last.pt \
  --steps 8000 \
  --train-cache "$CACHE" \
  --train-n 28539 \
  --eval-n 50 \
  --eval-every 2000 \
  --eval-both 0 \
  --eval-fp16 1 \
  --lr 1e-5 \
  --warmup-steps 100 \
  --lr-schedule cosine \
  --batch-size 2 \
  --max-new-tokens 128 \
  --alpha-mode delay \
  --alpha-warmup-frac 0.02 \
  --distill-weight 0.05 \
  --distill-temp 2.0 \
  --frozen-teacher 1 \
  --lazy-collate 1 \
  --save-dir data/checkpoints/qat_binary_full \
  --save-every 1000 \
  --out artifacts/stage1 \
  2>&1 | tee -a "$LOG"
