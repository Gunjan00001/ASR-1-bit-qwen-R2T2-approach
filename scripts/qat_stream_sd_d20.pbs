#!/bin/bash
#PBS -N asr1bit-sd-d20
#PBS -q gpu
#PBS -l select=1:ncpus=1:ngpus=1:mem=64gb
#PBS -l walltime=12:00:00
#PBS -j oe
#PBS -o /home/jiit_992401210050/stream_sd_d20.out
#
# Phase 4, arm d20 — streaming-state distillation, lambda_state = 0.05.
# Control is the verified aligned17b12 recipe (15.15 clean / 18.98 other):
# deep 9.85 base, lr 2.5e-6, 6 000 aligned (cached), mix 0.5, 2 000 steps.
# ONE variable changes: the per-chunk hidden-state MSE at decoder layer 14
# (middle), LayerNorm'd, target-token positions of streaming rows only.
#
# Submit: qsub scripts/qat_stream_sd_b05.pbs

set -u
unset CUDA_VISIBLE_DEVICES

ROOT="/home/jiit_992401210050/Desktop/ASR 1bit qwen"
cd "$ROOT" || exit 1

export PYTHONPATH="$ROOT/src"
export TOKENIZERS_PARALLELISM=false
export HF_HOME=/tmp/asr1bit/hf
LOG="artifacts/stage3/qat_stream_sd_d20.log"

PY=/home/jiit_992401210050/miniconda3/bin/python
if [ -d /tmp/asr1bit/models/Qwen3-ASR-1.7B ]; then
  MODEL=/tmp/asr1bit/models/Qwen3-ASR-1.7B
else
  MODEL=Qwen/Qwen3-ASR-1.7B
fi
if [ -f /tmp/asr1bit/qat_clean_train.100_n8000.pt ]; then
  CACHE=/tmp/asr1bit/qat_clean_train.100_n8000.pt
else
  CACHE="$ROOT/data/qat_clean_train.100_n8000.pt"
fi

PICK=$(bash scripts/pick_gpu_wait.sh 45000 "${PICK_WAIT_MIN:-120}") || exit 0
PICK="${QAT_GPU:-$PICK}"
export CUDA_VISIBLE_DEVICES="$PICK"

{
  echo "=== host $(hostname) | GPU $CUDA_VISIBLE_DEVICES | $(date) ==="
  nvidia-smi --query-gpu=index,name,memory.used,utilization.gpu --format=csv,noheader
} | tee "$LOG"

"$PY" scripts/run_stage1_qat.py \
  --model "$MODEL" \
  --policy decoder_attn_ffn \
  --bit-width 1.58 \
  --learnable-scale 1 \
  --init-from data/checkpoints/qat_17b_recover7/last.pt \
  --aligned-targets 1 \
  --aligned-n 6000 \
  --aligned-lookahead-ms 0 \
  --aligned-stop-stride 2 \
  --op-max-samples 2400 \
  --op-mix-frac 0.5 \
  --op-chunk-ms 320 \
  --steps 2000 \
  --seed 0 \
  --train-cache "$CACHE" \
  --train-n 2400 \
  --eval-n 50 \
  --eval-every 500 \
  --eval-both 0 \
  --eval-fp16 1 \
  --stream-eval-every 250 \
  --stream-eval-n 20 \
  --lr 2.5e-6 \
  --warmup-steps 100 \
  --lr-schedule cosine \
  --batch-size 1 \
  --optimizer adamw \
  --max-new-tokens 128 \
  --alpha-mode delay \
  --alpha-warmup-frac 0.02 \
  --distill-weight 0.05 \
  --distill-temp 2.0 \
  --frozen-teacher 1 \
  --state-distill-weight 0.20 \
  --state-distill-layer -1 \
  --state-distill-normalize 1 \
  --lazy-collate 1 \
  --save-dir data/checkpoints/qat_stream_sd_d20 \
  --keep-step-checkpoints 400 \
  --save-every 250 \
  --out artifacts/stage1 \
  2>&1 | tee -a "$LOG"
