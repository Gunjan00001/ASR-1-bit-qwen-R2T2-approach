#!/bin/bash
#PBS -N asr1bit-stream-sft-eval
#PBS -q gpu
#PBS -l select=1:ncpus=4:ngpus=1:mem=32gb
#PBS -l walltime=03:00:00
#PBS -j oe
#PBS -o /home/jiit_992401210050/stream_sft_eval.out
#
# Decisive test: streaming 320 ms with the OFFICIAL prefix-continuation
# algorithm (unfixed_token_num=5) on the prefix-continuation-trained checkpoint.
# Baseline: pretrained fp16 = 2.33 WER on the same 50 utts (measured earlier).
# Submit: qsub scripts/eval_streaming_sft.pbs

set -u
unset CUDA_VISIBLE_DEVICES

ROOT="/home/jiit_992401210050/Desktop/ASR 1bit qwen"
cd "$ROOT" || exit 1

export PYTHONPATH="$ROOT/src"
export TOKENIZERS_PARALLELISM=false
export HF_HOME=/tmp/asr1bit/hf
LOG="artifacts/stage1/eval_streaming_sft.log"

if [ -x /tmp/asr1bit/miniconda3/bin/python ]; then
  PY=/tmp/asr1bit/miniconda3/bin/python
else
  PY=/home/jiit_992401210050/miniconda3/bin/python
fi
MODEL=/tmp/asr1bit/models/Qwen3-ASR-0.6B
[ -d "$MODEL" ] || MODEL=Qwen/Qwen3-ASR-0.6B

PICK=$(for _ in 1 2 3; do
  nvidia-smi --query-gpu=index,memory.used,utilization.gpu --format=csv,noheader,nounits
  sleep 1
done | awk -F', ' '$2 < 55000 {u[$1]+=$3; m[$1]=$2} END {for (g in u) print u[g], m[g], g}' \
  | sort -n | head -1 | awk '{print $3}')
[ -z "$PICK" ] && PICK=$(nvidia-smi --query-gpu=index,memory.used --format=csv,noheader,nounits \
  | sort -t, -k2 -n | head -1 | cut -d, -f1 | tr -d ' ')
PICK="${EVAL_GPU:-$PICK}"
export CUDA_VISIBLE_DEVICES="$PICK"

{
  echo "=== host $(hostname) | GPU $CUDA_VISIBLE_DEVICES | $(date) ==="
} | tee "$LOG"

echo "=== prefix-trained ternary, official prefix algorithm (50 utts) ===" | tee -a "$LOG"
"$PY" scripts/eval_streaming.py \
  --model "$MODEL" --policy decoder_attn_ffn --bit-width 1.58 \
  --checkpoint data/checkpoints/qat_stream_sft/last.pt \
  --chunk-ms 320 --n 50 --max-new-tokens 32 --unfixed-token-num 5 \
  --conditions quantized \
  --out artifacts/stage1/streaming_ternary_sft_quantized.json \
  2>&1 | tee -a "$LOG"
