#!/bin/bash
#PBS -N asr1bit-diag-stream
#PBS -q gpu
#PBS -l select=1:ncpus=4:ngpus=1:mem=32gb
#PBS -l walltime=01:00:00
#PBS -j oe
#PBS -o /home/jiit_992401210050/diag_stream.out
#
# Per-chunk streaming trace: pretrained vs ternary QAT checkpoint on the same
# utterance. Shows where generation diverges (EOS, token counts, text).
# Submit: qsub scripts/diag_stream_generation.pbs

set -u
unset CUDA_VISIBLE_DEVICES

ROOT="/home/jiit_992401210050/Desktop/ASR 1bit qwen"
cd "$ROOT" || exit 1

export PYTHONPATH="$ROOT/src"
export TOKENIZERS_PARALLELISM=false
export HF_HOME=/tmp/asr1bit/hf

if [ -x /tmp/asr1bit/miniconda3/bin/python ]; then
  PY=/tmp/asr1bit/miniconda3/bin/python
else
  PY=/home/jiit_992401210050/miniconda3/bin/python
fi
MODEL=/tmp/asr1bit/models/Qwen3-ASR-0.6B
[ -d "$MODEL" ] || MODEL=Qwen/Qwen3-ASR-0.6B

PICK=$(for _ in 1 2 3; do
  nvidia-smi --query-gpu=index,memory.used,utilization.gpu --format=csv,noheader,nounits
  sleep 1
done | awk -F', ' '$2 < 55000 {u[$1]+=$3; m[$1]=$2} END {for (g in u) print u[g], m[g], g}' \
  | sort -n | head -1 | awk '{print $3}')
[ -z "$PICK" ] && PICK=$(nvidia-smi --query-gpu=index,memory.used --format=csv,noheader,nounits \
  | sort -t, -k2 -n | head -1 | cut -d, -f1 | tr -d ' ')
PICK="${EVAL_GPU:-$PICK}"
export CUDA_VISIBLE_DEVICES="$PICK"

echo "=== pretrained ==="
"$PY" scripts/diag_stream_generation.py \
  --model "$MODEL" --utterance 1 --chunk-ms 320 \
  --out artifacts/stage1/diag_stream_pretrained.json

echo "=== ternary long2 (warm-up skip 0.5 s) ==="
"$PY" scripts/diag_stream_generation.py \
  --model "$MODEL" --utterance 1 --chunk-ms 320 --min-decode-sec 0.5 \
  --checkpoint data/checkpoints/qat_ternary_long2/last.pt --bit-width 1.58 \
  --out artifacts/stage1/diag_stream_ternary_min05.json

echo "=== ternary long2 (warm-up skip 1.0 s) ==="
"$PY" scripts/diag_stream_generation.py \
  --model "$MODEL" --utterance 1 --chunk-ms 320 --min-decode-sec 1.0 \
  --checkpoint data/checkpoints/qat_ternary_long2/last.pt --bit-width 1.58 \
  --out artifacts/stage1/diag_stream_ternary_min10.json
