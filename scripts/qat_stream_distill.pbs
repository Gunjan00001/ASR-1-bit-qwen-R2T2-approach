#!/bin/bash
#PBS -N asr1bit-stream-distill
#PBS -q gpu
#PBS -l select=1:ncpus=4:ngpus=1:mem=48gb
#PBS -l walltime=08:00:00
#PBS -j oe
#PBS -o /home/jiit_992401210050/stream_distill.out
#
# WP1 — streaming-state distillation (replaces the DAgger-on-own-prefixes recipe).
#
# Why: phase 1 (on-policy SFT over the student's own prefixes) fixed the cold
# start (chunks 0-2 now emit EOS) but poisoned the model: the rollout's own
# prefixes contained repetition loops, and training "continue from a looping
# prefix -> reference remainder" taught those loops back to the model
# (diag: chunk 3+ degenerate into `language'S'S'S...`, official-algorithm WER
# 920). See docs/LAB_NOTES.md 2026-10-12.
#
# This run rolls out the **frozen pretrained teacher** (clean, EOS-terminated
# streaming policy, 2.33 WER with the official algorithm) and trains the student
# to reproduce the teacher's own continuation at the exact inference states —
# behavior cloning of a working streaming policy, never exposing the student to
# degenerate contexts. Blended 50/50 with standard offline samples.
# Init: best offline ternary (9.2). Submit: qsub scripts/qat_stream_distill.pbs

set -u
unset CUDA_VISIBLE_DEVICES

ROOT="/home/jiit_992401210050/Desktop/ASR 1bit qwen"
cd "$ROOT" || exit 1

export PYTHONPATH="$ROOT/src"
export TOKENIZERS_PARALLELISM=false
export HF_HOME=/tmp/asr1bit/hf
LOG="artifacts/stage1/qat_stream_distill.log"

if [ -x /tmp/asr1bit/miniconda3/bin/python ]; then
  PY=/tmp/asr1bit/miniconda3/bin/python
else
  PY=/home/jiit_992401210050/miniconda3/bin/python
fi
if [ -d /tmp/asr1bit/models/Qwen3-ASR-0.6B ]; then
  MODEL=/tmp/asr1bit/models/Qwen3-ASR-0.6B
else
  MODEL=Qwen/Qwen3-ASR-0.6B
fi
if [ -f /tmp/asr1bit/qat_clean_train.100_n8000.pt ]; then
  CACHE=/tmp/asr1bit/qat_clean_train.100_n8000.pt
else
  CACHE="$ROOT/data/qat_clean_train.100_n8000.pt"
fi

PICK=$(for _ in 1 2 3; do
  nvidia-smi --query-gpu=index,memory.used,utilization.gpu --format=csv,noheader,nounits
  sleep 1
done | awk -F', ' '$2 < 45000 {u[$1]+=$3; m[$1]=$2} END {for (g in u) print u[g], m[g], g}' \
  | sort -n | head -1 | awk '{print $3}')
[ -z "$PICK" ] && PICK=$(nvidia-smi --query-gpu=index,memory.used --format=csv,noheader,nounits \
  | sort -t, -k2 -n | head -1 | cut -d, -f1 | tr -d ' ')
PICK="${QAT_GPU:-$PICK}"
export CUDA_VISIBLE_DEVICES="$PICK"

{
  echo "=== host $(hostname) | GPU $CUDA_VISIBLE_DEVICES | cache $CACHE | $(date) ==="
  nvidia-smi --query-gpu=index,name,memory.used,utilization.gpu --format=csv,noheader
} | tee "$LOG"

"$PY" scripts/run_stage1_qat.py \
  --model "$MODEL" \
  --policy decoder_attn_ffn \
  --bit-width 1.58 \
  --learnable-scale 1 \
  --init-from data/checkpoints/qat_ternary_long2/last.pt \
  --op-rollout 1 \
  --op-distill 1 \
  --op-rollout-n 350 \
  --op-batch-size 6 \
  --op-max-new-tokens 32 \
  --op-chunk-ms 320 \
  --op-chunk-stride 3 \
  --op-max-rounds 16 \
  --op-max-samples 2400 \
  --op-mix-frac 0.5 \
  --op-refresh-every 0 \
  --steps 4000 \
  --train-cache "$CACHE" \
  --train-n 2400 \
  --eval-n 50 \
  --eval-every 1000 \
  --eval-both 0 \
  --eval-fp16 1 \
  --lr 1e-5 \
  --warmup-steps 100 \
  --lr-schedule cosine \
  --batch-size 2 \
  --max-new-tokens 128 \
  --alpha-mode delay \
  --alpha-warmup-frac 0.02 \
  --distill-weight 0.05 \
  --distill-temp 2.0 \
  --frozen-teacher 1 \
  --lazy-collate 1 \
  --save-dir data/checkpoints/qat_stream_distill \
  --save-every 500 \
  --out artifacts/stage1 \
  2>&1 | tee -a "$LOG"
