#!/bin/bash
#PBS -N asr1bit-stream-quantized
#PBS -q gpu
#PBS -l select=1:ncpus=4:ngpus=1:mem=32gb
#PBS -l walltime=04:00:00
#PBS -j oe
#PBS -o /home/jiit_992401210050/stream_quantized.out
#
# Stage 1 primary metric: streaming 320 ms on the SAME 50-utt sample for
#   (1) the pretrained model (fp16 baseline for the +X comparison),
#   (2) ternary long2 (9.2 WER offline) at its trained precision,
#   (3) binary long3 (10.7 WER offline) at its trained precision.
# The fp16 readout of QAT-trained shadows is NOT a valid baseline (drift →
# runaway generation; measured WER 1860 in the first attempt).
# Submit: qsub scripts/eval_streaming_quantized.pbs

set -u
unset CUDA_VISIBLE_DEVICES

ROOT="/home/jiit_992401210050/Desktop/ASR 1bit qwen"
cd "$ROOT" || exit 1

export PYTHONPATH="$ROOT/src"
export TOKENIZERS_PARALLELISM=false
export HF_HOME=/tmp/asr1bit/hf
LOG="artifacts/stage1/eval_streaming_quantized.log"

if [ -x /tmp/asr1bit/miniconda3/bin/python ]; then
  PY=/tmp/asr1bit/miniconda3/bin/python
else
  PY=/home/jiit_992401210050/miniconda3/bin/python
fi
MODEL=/tmp/asr1bit/models/Qwen3-ASR-0.6B
[ -d "$MODEL" ] || MODEL=Qwen/Qwen3-ASR-0.6B

PICK=$(for _ in 1 2 3; do
  nvidia-smi --query-gpu=index,memory.used,utilization.gpu --format=csv,noheader,nounits
  sleep 1
done | awk -F', ' '$2 < 55000 {u[$1]+=$3; m[$1]=$2} END {for (g in u) print u[g], m[g], g}' \
  | sort -n | head -1 | awk '{print $3}')
[ -z "$PICK" ] && PICK=$(nvidia-smi --query-gpu=index,memory.used --format=csv,noheader,nounits \
  | sort -t, -k2 -n | head -1 | cut -d, -f1 | tr -d ' ')
PICK="${EVAL_GPU:-$PICK}"
export CUDA_VISIBLE_DEVICES="$PICK"

{
  echo "=== host $(hostname) | GPU $CUDA_VISIBLE_DEVICES | $(date) ==="
} | tee "$LOG"

echo "=== (1) pretrained fp16 baseline, 50 utts ===" | tee -a "$LOG"
"$PY" scripts/eval_streaming.py \
  --model "$MODEL" --policy decoder_attn_ffn --bit-width 1.58 \
  --chunk-ms 320 --n 50 --max-new-tokens 32 --unfixed-token-num 9999 --conditions fp16 \
  --out artifacts/stage1/streaming_pretrained_50.json \
  2>&1 | tee -a "$LOG"

echo "=== (2) ternary long2 (9.2 offline), quantized, 50 utts ===" | tee -a "$LOG"
"$PY" scripts/eval_streaming.py \
  --model "$MODEL" --policy decoder_attn_ffn --bit-width 1.58 \
  --checkpoint data/checkpoints/qat_ternary_long2/last.pt \
  --chunk-ms 320 --n 50 --max-new-tokens 32 --unfixed-token-num 9999 --conditions quantized \
  --out artifacts/stage1/streaming_ternary_long2_quantized.json \
  2>&1 | tee -a "$LOG"

echo "=== (3) binary long3 (10.7 offline), quantized, 50 utts ===" | tee -a "$LOG"
"$PY" scripts/eval_streaming.py \
  --model "$MODEL" --policy decoder_attn_ffn --bit-width 1.0 \
  --checkpoint data/checkpoints/qat_binary_long3/last.pt \
  --chunk-ms 320 --n 50 --max-new-tokens 32 --unfixed-token-num 9999 --conditions quantized \
  --out artifacts/stage1/streaming_binary_long3_quantized.json \
  2>&1 | tee -a "$LOG"
