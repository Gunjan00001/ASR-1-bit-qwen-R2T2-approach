#!/bin/bash
#PBS -N asr1bit-aligned17b18
#PBS -q gpu
#PBS -l select=1:ncpus=4:ngpus=1:mem=64gb
#PBS -l walltime=12:00:00
#PBS -j oe
#PBS -o /home/jiit_992401210050/stream_aligned17b18.out
#
# Stage 3/4 — MIXED-PRECISION LR PILOT (aligned17b18, lr 5e-7).
# b17 (FFN-only quantization, attention fp16) is numerically healthy but its
# streaming guardrail explodes (WER 1 349 -> 902 with CER *below* WER, i.e.
# repetitive loops) while its offline readout stays normal (19.39). Hypothesis:
# the QAT-calibrated lr is too large for the unquantized attention, whose
# median grad norm is ~2x b12's. This pilot is the direct test — same init,
# same policy, same data, same streaming algorithm; ONE variable vs b17: the
# learning rate. 500 steps with a guardrail every 100 so an unhealthy setting
# is eliminated in ~1 h rather than 6.
#
# Documented schedule choice: warmup stays 100 (unchanged from b12/b17) even
# though it is 20 % of this pilot's budget; changing it would add a second
# variable. A pilot that is healthy at 500 steps graduates to a full run with
# the same warmup.
#
# Submit: qsub scripts/qat_stream_aligned17b18.pbs

set -u
unset CUDA_VISIBLE_DEVICES

ROOT="/home/jiit_992401210050/Desktop/ASR 1bit qwen"
cd "$ROOT" || exit 1

export PYTHONPATH="$ROOT/src"
export TOKENIZERS_PARALLELISM=false
export HF_HOME=/tmp/asr1bit/hf
LOG="artifacts/stage3/qat_stream_aligned17b18.log"

PY=/home/jiit_992401210050/miniconda3/bin/python  # bitsandbytes lives in the shared env
if [ -d /tmp/asr1bit/models/Qwen3-ASR-1.7B ]; then
  MODEL=/tmp/asr1bit/models/Qwen3-ASR-1.7B
else
  MODEL=Qwen/Qwen3-ASR-1.7B
fi
if [ -f /tmp/asr1bit/qat_clean_train.100_n8000.pt ]; then
  CACHE=/tmp/asr1bit/qat_clean_train.100_n8000.pt
else
  CACHE="$ROOT/data/qat_clean_train.100_n8000.pt"
fi

PICK=$(bash scripts/pick_gpu_wait.sh 45000 "${PICK_WAIT_MIN:-120}") || exit 0
PICK="${QAT_GPU:-$PICK}"
export CUDA_VISIBLE_DEVICES="$PICK"

{
  echo "=== host $(hostname) | GPU $CUDA_VISIBLE_DEVICES | $(date) ==="
  nvidia-smi --query-gpu=index,name,memory.used,utilization.gpu --format=csv,noheader
} | tee "$LOG"

"$PY" scripts/run_stage1_qat.py \
  --model "$MODEL" \
  --policy decoder_ffn \
  --bit-width 1.58 \
  --learnable-scale 1 \
  --init-from data/checkpoints/qat_17b_recover7/last.pt \
  --aligned-targets 1 \
  --aligned-n 6000 \
  --aligned-lookahead-ms 0 \
  --aligned-stop-stride 2 \
  --op-max-samples 2400 \
  --op-mix-frac 0.5 \
  --op-chunk-ms 320 \
  --steps 500 \
  --train-cache "$CACHE" \
  --train-n 2400 \
  --eval-n 50 \
  --eval-every 250 \
  --eval-both 0 \
  --eval-fp16 1 \
  --stream-eval-every 100 \
  --stream-eval-n 20 \
  --lr 5e-7 \
  --warmup-steps 100 \
  --lr-schedule cosine \
  --batch-size 1 \
  --optimizer adamw \
  --max-new-tokens 128 \
  --alpha-mode delay \
  --alpha-warmup-frac 0.02 \
  --distill-weight 0.05 \
  --distill-temp 2.0 \
  --frozen-teacher 1 \
  --lazy-collate 1 \
  --save-dir data/checkpoints/qat_stream_aligned17b18 \
  --keep-step-checkpoints 200 \
  --save-every 250 \
  --out artifacts/stage1 \
  2>&1 | tee -a "$LOG"
