#!/bin/bash
#PBS -N asr1bit-stream-opd
#PBS -q gpu
#PBS -l select=1:ncpus=4:ngpus=1:mem=48gb
#PBS -l walltime=08:00:00
#PBS -j oe
#PBS -o /home/jiit_992401210050/stream_opd.out
#
# WP1 phase 1 — on-policy streaming SFT (Stage 4).
#
# The official prefix algorithm collapses for QAT models (203.5 WER) because the
# model was never trained to continue *its own* rolled-back text. This job
# replays the official streaming algorithm with the current model (320 ms
# chunks, official rollback), records (audio heard, own prompt, own text) states
# and trains the continuation of the reference remainder — blended 50/50 with
# standard offline samples to protect offline quality.
# Init: best offline ternary (9.2). Submit: qsub scripts/qat_stream_opd.pbs
#
# Rollout sizing: 350 utterances (≈2 800 kept states) — measured ~460 s per
# rollout round under the current cluster contention (all 8 A100s 70-100 % busy
# by other users), so 700 utts would eat most of the walltime; training steps
# matter more here than a larger pool of the same distribution.

set -u
unset CUDA_VISIBLE_DEVICES

ROOT="/home/jiit_992401210050/Desktop/ASR 1bit qwen"
cd "$ROOT" || exit 1

export PYTHONPATH="$ROOT/src"
export TOKENIZERS_PARALLELISM=false
export HF_HOME=/tmp/asr1bit/hf
LOG="artifacts/stage1/qat_stream_opd.log"

if [ -x /tmp/asr1bit/miniconda3/bin/python ]; then
  PY=/tmp/asr1bit/miniconda3/bin/python
else
  PY=/home/jiit_992401210050/miniconda3/bin/python
fi
if [ -d /tmp/asr1bit/models/Qwen3-ASR-0.6B ]; then
  MODEL=/tmp/asr1bit/models/Qwen3-ASR-0.6B
else
  MODEL=Qwen/Qwen3-ASR-0.6B
fi
if [ -f /tmp/asr1bit/qat_clean_train.100_n8000.pt ]; then
  CACHE=/tmp/asr1bit/qat_clean_train.100_n8000.pt
else
  CACHE="$ROOT/data/qat_clean_train.100_n8000.pt"
fi

# Least-utilized GPU (3-sample average) with >= ~35 GiB free.
PICK=$(for _ in 1 2 3; do
  nvidia-smi --query-gpu=index,memory.used,utilization.gpu --format=csv,noheader,nounits
  sleep 1
done | awk -F', ' '$2 < 45000 {u[$1]+=$3; m[$1]=$2} END {for (g in u) print u[g], m[g], g}' \
  | sort -n | head -1 | awk '{print $3}')
[ -z "$PICK" ] && PICK=$(nvidia-smi --query-gpu=index,memory.used --format=csv,noheader,nounits \
  | sort -t, -k2 -n | head -1 | cut -d, -f1 | tr -d ' ')
PICK="${QAT_GPU:-$PICK}"
export CUDA_VISIBLE_DEVICES="$PICK"

{
  echo "=== host $(hostname) | GPU $CUDA_VISIBLE_DEVICES | cache $CACHE | $(date) ==="
  nvidia-smi --query-gpu=index,name,memory.used,utilization.gpu --format=csv,noheader
} | tee "$LOG"

"$PY" scripts/run_stage1_qat.py \
  --model "$MODEL" \
  --policy decoder_attn_ffn \
  --bit-width 1.58 \
  --learnable-scale 1 \
  --init-from data/checkpoints/qat_ternary_long2/last.pt \
  --op-rollout 1 \
  --op-rollout-n 350 \
  --op-batch-size 6 \
  --op-max-new-tokens 32 \
  --op-chunk-ms 320 \
  --op-chunk-stride 3 \
  --op-max-rounds 16 \
  --op-max-samples 2400 \
  --op-mix-frac 0.5 \
  --op-refresh-every 0 \
  --op-warmup-eos 1 \
  --steps 3000 \
  --train-cache "$CACHE" \
  --train-n 2400 \
  --eval-n 50 \
  --eval-every 1000 \
  --eval-both 0 \
  --eval-fp16 1 \
  --lr 1e-5 \
  --warmup-steps 100 \
  --lr-schedule cosine \
  --batch-size 2 \
  --max-new-tokens 128 \
  --alpha-mode delay \
  --alpha-warmup-frac 0.02 \
  --distill-weight 0.05 \
  --distill-temp 2.0 \
  --frozen-teacher 1 \
  --lazy-collate 1 \
  --save-dir data/checkpoints/qat_stream_opd \
  --save-every 500 \
  --out artifacts/stage1 \
  2>&1 | tee -a "$LOG"
