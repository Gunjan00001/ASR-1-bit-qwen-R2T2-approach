#!/bin/bash
#PBS -N asr1bit-aligned17b15
#PBS -q gpu
#PBS -l select=1:ncpus=4:ngpus=1:mem=64gb
#PBS -l walltime=12:00:00
#PBS -j oe
#PBS -o /home/jiit_992401210050/stream_aligned17b15.out
#
# Stage 3/4 — the LONG-RUN arm: 6 000 steps on the line-best recipe.
# The recipe's three axes are settled (lr 2.5e-6, 6 000 aligned, mix 0.5); the
# remaining recipe question is duration. The 2 000-step runs peak late (b12's
# best was step 1 600 of 2 000), so a 6 000-step cosine schedule lets the late
# phase actually finish. One variable vs b12: --steps 2 000 -> 6 000.
#
# WALLTIME: 12 h covers ~2 900 steps at the measured ~4/min. The run is
# designed to be RESUMED: step checkpoints every 400 exist, and the LR schedule
# advances to the resumed position (the trainer sets scheduler.last_epoch).
# Snapshot last.pt before each resume. Aligned words are cached (6 000 key),
# so every chunk starts training immediately.
#
# Submit: qsub scripts/qat_stream_aligned17b15.pbs

set -u
unset CUDA_VISIBLE_DEVICES

ROOT="/home/jiit_992401210050/Desktop/ASR 1bit qwen"
cd "$ROOT" || exit 1

export PYTHONPATH="$ROOT/src"
export TOKENIZERS_PARALLELISM=false
export HF_HOME=/tmp/asr1bit/hf
LOG="artifacts/stage3/qat_stream_aligned17b15.log"

PY=/home/jiit_992401210050/miniconda3/bin/python  # bitsandbytes lives in the shared env
if [ -d /tmp/asr1bit/models/Qwen3-ASR-1.7B ]; then
  MODEL=/tmp/asr1bit/models/Qwen3-ASR-1.7B
else
  MODEL=Qwen/Qwen3-ASR-1.7B
fi
if [ -f /tmp/asr1bit/qat_clean_train.100_n8000.pt ]; then
  CACHE=/tmp/asr1bit/qat_clean_train.100_n8000.pt
else
  CACHE="$ROOT/data/qat_clean_train.100_n8000.pt"
fi

PICK=$(bash scripts/pick_gpu_wait.sh 45000 "${PICK_WAIT_MIN:-120}") || exit 0
PICK="${QAT_GPU:-$PICK}"
export CUDA_VISIBLE_DEVICES="$PICK"

{
  echo "=== host $(hostname) | GPU $CUDA_VISIBLE_DEVICES | $(date) ==="
  nvidia-smi --query-gpu=index,name,memory.used,utilization.gpu --format=csv,noheader
} | tee "$LOG"

"$PY" scripts/run_stage1_qat.py \
  --model "$MODEL" \
  --policy decoder_attn_ffn \
  --bit-width 1.58 \
  --learnable-scale 1 \
  --init-from data/checkpoints/qat_17b_recover7/last.pt \
  --aligned-targets 1 \
  --aligned-n 6000 \
  --aligned-lookahead-ms 0 \
  --aligned-stop-stride 2 \
  --op-max-samples 2400 \
  --op-mix-frac 0.5 \
  --op-chunk-ms 320 \
  --steps 6000 \
  --train-cache "$CACHE" \
  --train-n 2400 \
  --eval-n 50 \
  --eval-every 500 \
  --eval-both 0 \
  --eval-fp16 1 \
  --stream-eval-every 250 \
  --stream-eval-n 20 \
  --lr 2.5e-6 \
  --warmup-steps 100 \
  --lr-schedule cosine \
  --batch-size 1 \
  --optimizer adamw \
  --max-new-tokens 128 \
  --alpha-mode delay \
  --alpha-warmup-frac 0.02 \
  --distill-weight 0.05 \
  --distill-temp 2.0 \
  --frozen-teacher 1 \
  --lazy-collate 1 \
  --save-dir data/checkpoints/qat_stream_aligned17b15 \
  --keep-step-checkpoints 400 \
  --save-every 250 \
  --out artifacts/stage1 \
  2>&1 | tee -a "$LOG"
