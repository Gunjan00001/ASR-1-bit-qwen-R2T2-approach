#!/bin/bash
#PBS -N asr1bit-aligned17b9
#PBS -q gpu
#PBS -l select=1:ncpus=4:ngpus=1:mem=64gb
#PBS -l walltime=10:00:00
#PBS -j oe
#PBS -o /home/jiit_992401210050/stream_aligned17b9.out
#
# Stage 3/4 — aligned streaming SFT on top of the *offline-recovered* base:
# the recover arms proved the base improves with lr 5e-6 (recover3: 20.55 ->
# 16.53 offline) but plain-offline training breaks the streaming head (285 WER
# on the official algorithm with 354 loops). This run replays the aligned
# recipe on that recovered checkpoint to test the two-stage (recover then
# re-align) doctrine. One variable vs the aligned17b4 attempt: recovered base +
# lr 5e-6.
#
# Targets come from the *forced aligner*, not from the model or the teacher:
# at each 320 ms chunk the sample's target is exactly the words whose end time
# falls inside that chunk (T4.2), i.e. "emit what you have heard, then stop".
# That is the supervision the earlier streaming recipes lacked, and it addresses
# both measured failure directions at once (under-emission and repetition
# loops). Empty-target chunks are the stop samples; `--aligned-stop-stride 2`
# keeps every second one so the mix is not dominated by silence teaching.
# Stage 3 retry (v3): the 1.7B aligned run at lr 3e-6/anchor-free dipped
# 20.55 -> 31.6 and never recovered. This run restarts from the PRE-DIP
# checkpoint (attn5) at lr 1.5e-6 and restores the anchor.
# Guardrail: 20-utt official-algorithm `STREAM` evals every 250 steps.
# Submit: qsub scripts/qat_stream_aligned17b4.pbs

set -u
unset CUDA_VISIBLE_DEVICES

ROOT="/home/jiit_992401210050/Desktop/ASR 1bit qwen"
cd "$ROOT" || exit 1

export PYTHONPATH="$ROOT/src"
export TOKENIZERS_PARALLELISM=false
export HF_HOME=/tmp/asr1bit/hf
LOG="artifacts/stage3/qat_stream_aligned17b9.log"

PY=/home/jiit_992401210050/miniconda3/bin/python  # bitsandbytes lives in the shared env
if [ -d /tmp/asr1bit/models/Qwen3-ASR-1.7B ]; then
  MODEL=/tmp/asr1bit/models/Qwen3-ASR-1.7B
else
  MODEL=Qwen/Qwen3-ASR-1.7B
fi
if [ -f /tmp/asr1bit/qat_clean_train.100_n8000.pt ]; then
  CACHE=/tmp/asr1bit/qat_clean_train.100_n8000.pt
else
  CACHE="$ROOT/data/qat_clean_train.100_n8000.pt"
fi

PICK=$(bash scripts/pick_gpu_wait.sh 45000 "${PICK_WAIT_MIN:-120}") || exit 0
PICK="${QAT_GPU:-$PICK}"
export CUDA_VISIBLE_DEVICES="$PICK"

{
  echo "=== host $(hostname) | GPU $CUDA_VISIBLE_DEVICES | $(date) ==="
  nvidia-smi --query-gpu=index,name,memory.used,utilization.gpu --format=csv,noheader
} | tee "$LOG"

"$PY" scripts/run_stage1_qat.py \
  --model "$MODEL" \
  --policy decoder_attn_ffn \
  --bit-width 1.58 \
  --learnable-scale 1 \
  --init-from data/checkpoints/qat_17b_recover6/last.pt \
  --aligned-targets 1 \
  --aligned-n 1200 \
  --aligned-lookahead-ms 0 \
  --aligned-stop-stride 2 \
  --op-max-samples 2400 \
  --op-mix-frac 0.5 \
  --op-chunk-ms 320 \
  --steps 2000 \
  --train-cache "$CACHE" \
  --train-n 2400 \
  --eval-n 50 \
  --eval-every 500 \
  --eval-both 0 \
  --eval-fp16 1 \
  --stream-eval-every 250 \
  --stream-eval-n 20 \
  --lr 5e-6 \
  --warmup-steps 100 \
  --lr-schedule cosine \
  --batch-size 1 \
  --optimizer adamw \
  --max-new-tokens 128 \
  --alpha-mode delay \
  --alpha-warmup-frac 0.02 \
  --distill-weight 0.05 \
  --distill-temp 2.0 \
  --frozen-teacher 1 \
  --lazy-collate 1 \
  --save-dir data/checkpoints/qat_stream_aligned17b9 \
  --keep-step-checkpoints 400 \
  --save-every 250 \
  --out artifacts/stage1 \
  2>&1 | tee -a "$LOG"
