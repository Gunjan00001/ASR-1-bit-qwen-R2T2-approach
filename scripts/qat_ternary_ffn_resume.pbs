#!/bin/bash
#PBS -N asr1bit-qat-ffn-resume
#PBS -q gpu
#PBS -l select=1:ncpus=8:ngpus=1:mem=64gb
#PBS -l walltime=04:00:00
#PBS -j oe
#PBS -o /home/jiit_992401210050/qat_ffn_resume.out
#
# Resume the FFN-only ternary run (step 2000 -> 3000) on the least-utilized GPU
# with enough free memory, instead of waiting for the original job's GPU.
# Per rules.md R1. Submit, then kill the slow original job:
#   qsub scripts/qat_ternary_ffn_resume.pbs && qdel 10737

set -u
unset CUDA_VISIBLE_DEVICES

ROOT="/home/jiit_992401210050/Desktop/ASR 1bit qwen"
cd "$ROOT" || exit 1

export PYTHONPATH="$ROOT/src"
export TOKENIZERS_PARALLELISM=false
export HF_HOME=/tmp/asr1bit/hf
LOG="artifacts/stage1/qat_ternary_ffn_resume.log"

if [ -x /tmp/asr1bit/miniconda3/bin/python ]; then
  PY=/tmp/asr1bit/miniconda3/bin/python
else
  PY=/home/jiit_992401210050/miniconda3/bin/python
fi
if [ -d /tmp/asr1bit/models/Qwen3-ASR-0.6B ]; then
  MODEL=/tmp/asr1bit/models/Qwen3-ASR-0.6B
else
  MODEL=Qwen/Qwen3-ASR-0.6B
fi
if [ -f /tmp/asr1bit/qat_clean_train.100_n4000.pt ]; then
  CACHE=/tmp/asr1bit/qat_clean_train.100_n4000.pt
else
  CACHE="$ROOT/data/qat_clean_train.100_n4000.pt"
fi

# Prefer the least-utilized GPU with >= ~25 GiB free; fall back to least memory.
PICK=$(nvidia-smi --query-gpu=index,memory.used,utilization.gpu --format=csv,noheader,nounits \
  | awk -F', ' '$2 < 55000 {print $3+0, $2+0, $1}' | sort -n | head -1 | awk '{print $3}')
if [ -z "$PICK" ]; then
  PICK=$(nvidia-smi --query-gpu=index,memory.used --format=csv,noheader,nounits \
    | sort -t, -k2 -n | head -1 | cut -d, -f1 | tr -d ' ')
fi
export CUDA_VISIBLE_DEVICES="$PICK"

{
  echo "=== host $(hostname) | GPU $CUDA_VISIBLE_DEVICES | $(date) ==="
  nvidia-smi --query-gpu=index,name,memory.used,utilization.gpu --format=csv,noheader
} | tee "$LOG"

"$PY" scripts/run_stage1_qat.py \
  --model "$MODEL" \
  --policy decoder_ffn \
  --bit-width 1.58 \
  --learnable-scale 1 \
  --steps 3000 \
  --train-cache "$CACHE" \
  --train-n 4000 \
  --eval-n 50 \
  --eval-every 500 \
  --eval-both 0 \
  --lr 2e-4 \
  --warmup-steps 100 \
  --lr-schedule cosine \
  --batch-size 4 \
  --max-new-tokens 128 \
  --alpha-mode delay \
  --alpha-warmup-frac 0.05 \
  --lazy-collate 1 \
  --resume data/checkpoints/qat_ternary_ffn/last.pt \
  --save-dir data/checkpoints/qat_ternary_ffn_resume \
  --save-every 500 \
  --out artifacts/stage1 \
  2>&1 | tee -a "$LOG"
