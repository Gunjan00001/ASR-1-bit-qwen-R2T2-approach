#!/bin/bash
#PBS -N asr1bit-qat-distill
#PBS -q gpu
#PBS -l select=1:ncpus=4:ngpus=1:mem=48gb
#PBS -l walltime=08:00:00
#PBS -j oe
#PBS -o /home/jiit_992401210050/qat_distill.out
#
# Stage 2-lite recovery: QAT + self-distillation (teacher = same shadows at
# alpha=0). Ternary, decoder_attn_ffn, learnable scales. Submit:
#   qsub scripts/qat_ternary_distill.pbs

set -u
unset CUDA_VISIBLE_DEVICES

ROOT="/home/jiit_992401210050/Desktop/ASR 1bit qwen"
cd "$ROOT" || exit 1

export PYTHONPATH="$ROOT/src"
export TOKENIZERS_PARALLELISM=false
export HF_HOME=/tmp/asr1bit/hf
LOG="artifacts/stage1/qat_ternary_distill.log"

if [ -x /tmp/asr1bit/miniconda3/bin/python ]; then
  PY=/tmp/asr1bit/miniconda3/bin/python
else
  PY=/home/jiit_992401210050/miniconda3/bin/python
fi
if [ -d /tmp/asr1bit/models/Qwen3-ASR-0.6B ]; then
  MODEL=/tmp/asr1bit/models/Qwen3-ASR-0.6B
else
  MODEL=Qwen/Qwen3-ASR-0.6B
fi
if [ -f /tmp/asr1bit/qat_clean_train.100_n4000.pt ]; then
  CACHE=/tmp/asr1bit/qat_clean_train.100_n4000.pt
else
  CACHE="$ROOT/data/qat_clean_train.100_n4000.pt"
fi

# PBS does not pin GPUs; pick the least-used one for this job.
export CUDA_VISIBLE_DEVICES=$(
  nvidia-smi --query-gpu=index,memory.used --format=csv,noheader,nounits \
    | sort -t, -k2 -n | head -1 | cut -d, -f1 | tr -d ' '
)

{
  echo "=== host $(hostname) | GPU $CUDA_VISIBLE_DEVICES | $(date) ==="
  nvidia-smi --query-gpu=index,name,memory.used --format=csv,noheader
} | tee "$LOG"

"$PY" scripts/run_stage1_qat.py \
  --model "$MODEL" \
  --policy decoder_attn_ffn \
  --bit-width 1.58 \
  --learnable-scale 1 \
  --steps 4000 \
  --train-cache "$CACHE" \
  --train-n 4000 \
  --eval-n 50 \
  --eval-every 1000 \
  --eval-both 0 \
  --lr 2e-4 \
  --warmup-steps 100 \
  --lr-schedule cosine \
  --batch-size 2 \
  --max-new-tokens 128 \
  --alpha-mode delay \
  --alpha-warmup-frac 0.05 \
  --distill-weight 0.5 \
  --distill-temp 2.0 \
  --lazy-collate 1 \
  --save-dir data/checkpoints/qat_ternary_distill \
  --save-every 500 \
  --out artifacts/stage1 \
  2>&1 | tee -a "$LOG"
