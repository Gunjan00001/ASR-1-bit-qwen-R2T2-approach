#!/bin/bash
#PBS -N asr1bit-eval-bines
#PBS -q gpu
#PBS -l select=1:ncpus=4:ngpus=1:mem=48gb
#PBS -l walltime=04:00:00
#PBS -j oe
#PBS -o /home/jiit_992401210050/eval_bines.out
#
# Evaluate the binary early-stopping run's step-checkpoints (clean, loop policy
# on) in ONE job so the best state can be picked even on a crowded queue.
# Submit after scripts/qat_stream_bin_es.pbs ends (the step checkpoints must
# exist): qsub scripts/eval_bin_es.pbs

set -u
unset CUDA_VISIBLE_DEVICES

ROOT="/home/jiit_992401210050/Desktop/ASR 1bit qwen"
cd "$ROOT" || exit 1

export PYTHONPATH="$ROOT/src"
export TOKENIZERS_PARALLELISM=false
export HF_HOME=/tmp/asr1bit/hf
LOG="artifacts/stage1/eval_bin_es.log"
CKPT_DIR="${CKPT_DIR:-data/checkpoints/qat_stream_bin_es}"

if [ -x /tmp/asr1bit/miniconda3/bin/python ]; then
  PY=/tmp/asr1bit/miniconda3/bin/python
else
  PY=/home/jiit_992401210050/miniconda3/bin/python
fi
if [ -d /tmp/asr1bit/models/Qwen3-ASR-0.6B ]; then
  MODEL=/tmp/asr1bit/models/Qwen3-ASR-0.6B
else
  MODEL=Qwen/Qwen3-ASR-0.6B
fi

PICK=$(for _ in 1 2 3; do
  nvidia-smi --query-gpu=index,memory.used,utilization.gpu --format=csv,noheader,nounits
  sleep 1
done | awk -F', ' '$2 < 45000 {u[$1]+=$3; m[$1]=$2} END {for (g in u) print u[g], m[g], g}' \
  | sort -n | head -1 | awk '{print $3}')
[ -z "$PICK" ] && PICK=$(nvidia-smi --query-gpu=index,memory.used --format=csv,noheader,nounits \
  | sort -t, -k2 -n | head -1 | cut -d, -f1 | tr -d ' ')
PICK="${EVAL_GPU:-$PICK}"
export CUDA_VISIBLE_DEVICES="$PICK"

{
  echo "=== host $(hostname) | GPU $CUDA_VISIBLE_DEVICES | ckpt dir $CKPT_DIR | $(date) ==="
  nvidia-smi --query-gpu=index,name,memory.used,utilization.gpu --format=csv,noheader
} | tee "$LOG"

for STEP in 500 1000 1500; do
  CKPT="$CKPT_DIR/step${STEP}.pt"
  if [ ! -f "$CKPT" ]; then
    echo "skip step $STEP (no $CKPT)" | tee -a "$LOG"
    continue
  fi
  echo "=== step $STEP ===" | tee -a "$LOG"
  "$PY" scripts/eval_streaming.py \
    --model "$MODEL" \
    --checkpoint "$CKPT" \
    --policy decoder_attn_ffn \
    --bit-width 1.0 \
    --chunk-ms 320 \
    --n 50 \
    --max-new-tokens 32 \
    --unfixed-token-num 5 \
    --lsp-margin-words 3 \
    --lsp-truncate-loops 1 \
    --conditions quantized \
    --out "artifacts/stage1/streaming_bines_step${STEP}.json" \
    2>&1 | tee -a "$LOG"
done
